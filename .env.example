# ──────────────────────────────────────────────────────────────
#  CertiTrackKTI — Production Environment Variables
#  Used by docker-compose-prod.yml on the VPS
#
#  Copy this file:  cp .env.example .env
#  Then fill in the values below.
# ──────────────────────────────────────────────────────────────

# MongoDB password
# Used by both the MongoDB container and the backend connection string
# Choose a strong password — avoid special characters like @ # $ & in the password
# as they need URL-encoding in the connection string
MONGO_PASSWORD=change_me_to_a_strong_password

# JWT secret — must be a long random string, never share this
# Generate one: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_secret

# Cloudflare Tunnel token
# Get this from: Cloudflare Zero Trust → Networks → Tunnels → your tunnel → Configure
TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# CORS allowed origins — comma-separated, no trailing slash
# This should match the public URL of your frontend
CORS_ORIGINS=https://yourdomain.com
